# Conexão do banco Neon (pooled). O `neon deploy` / `neon env pull` preenche no .env.local
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Segredo que assina o cookie de login (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
